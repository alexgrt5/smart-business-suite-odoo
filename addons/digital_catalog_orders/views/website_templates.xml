<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="catalog_page" name="Página del catálogo">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="text-center mb-5">
                    <h1><t t-esc="catalog.name"/></h1>
                    <p><t t-esc="catalog.description"/></p>
                </div>

                <div class="row">
                    <t t-foreach="catalog.product_ids" t-as="product">
                        <div class="col-lg-3 col-md-4 col-6 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6><t t-esc="product.name"/></h6>

                                    <t t-if="catalog.show_prices">
                                        <p class="fw-bold">$<t t-esc="product.list_price"/></p>
                                    </t>

                                    <button type="button"
                                            class="btn btn-dark btn-sm w-100 add-to-cart"
                                            t-att-data-id="product.id"
                                            t-att-data-name="product.name"
                                            t-att-data-price="product.list_price">
                                        Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <hr/>

                <h3>Pedido</h3>

                <div id="cart-items" class="mb-3"></div>

                <form t-att-action="'/catalogo/%s/pedido' % catalog.slug" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="cart_data" id="cart_data"/>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Nombre</label>
                            <input name="partner_name" class="form-control" required="required"/>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Teléfono</label>
                            <input name="partner_phone" class="form-control" required="required"/>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Correo electrónico</label>
                            <input name="partner_email" type="email" class="form-control"/>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Tipo de entrega</label>
                            <select name="delivery_type" class="form-control">
                                <option value="pickup">Recoger en tienda</option>
                                <option value="delivery">Entrega a domicilio</option>
                            </select>
                        </div>

                        <div class="col-12 mb-3">
                            <label>Dirección de entrega</label>
                            <textarea name="delivery_address" class="form-control"></textarea>
                        </div>

                        <div class="col-12 mb-3">
                            <label>Notas</label>
                            <textarea name="notes" class="form-control"></textarea>
                        </div>
                    </div>

                    <button class="btn btn-success">
                        Enviar pedido
                    </button>
                </form>
            </div>
        </t>
    </template>

    <template id="catalog_order_success" name="Pedido enviado">
        <t t-call="website.layout">
            <div class="container my-5 text-center">
                <h1>Pedido enviado correctamente</h1>
                <p>Tu pedido fue registrado con la referencia:</p>
                <h3><t t-esc="order.name"/></h3>
                <a t-att-href="'/catalogo/%s' % catalog.slug" class="btn btn-dark mt-3">
                    Volver al catálogo
                </a>
            </div>
        </t>
    </template>

</odoo>